{
	"name": "@ungate/root",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.33.1",
	"engines": {
		"node": ">=22.0.0",
		"pnpm": ">=10.0.0"
	},
	"scripts": {
		"tunnel": "pnpm --filter @ungate/scripts run tunnel",
