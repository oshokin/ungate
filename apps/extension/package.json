{
	"name": "ungate",
	"displayName": "Ungate",
	"description": "Use Claude, GPT, or MiniMax subscriptions in Cursor instead of paying for API tokens",
	"version": "1.7.14",
	"publisher": "orchidfiles",
	"license": "MIT",
	"pricing": "Free",
	"author": {
		"name": "oshokin",
		"url": "https://github.com/oshokin"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/oshokin/ungate.git"
	},
	"bugs": {
		"url": "https://github.com/oshokin/ungate/issues"
	},
	"homepage": "https://github.com/oshokin/ungate",
	"keywords": [
		"claude",
		"anthropic",
		"chatgpt",
		"gpt",
		"minimax",
		"cursor",
		"proxy",
		"openai",
		"ai"
	],
	"engines": {
		"vscode": "^1.96.0"
	},
	"categories": [
		"Other"
	],
	"icon": "resources/icon.png",
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./dist/extension.js",
	"extensionKind": [
		"ui"
	],
	"contributes": {
		"commands": [
			{
				"command": "ungate.openDashboard",
				"title": "Open Dashboard",
				"category": "Ungate"
			},
			{
				"command": "ungate.openCursorModels",
				"title": "Open Cursor Models",
				"category": "Ungate",
				"icon": "$(list-selection)"
			},
			{
				"command": "ungate.copyTunnelUrl",
				"title": "Copy Tunnel URL",
				"category": "Ungate"
			},
			{
				"command": "ungate.copyApiKey",
				"title": "Copy API Key",
				"category": "Ungate"
			},
			{
				"command": "ungate.reloadWindow",
				"title": "Reload Window",
				"category": "Ungate",
				"icon": "$(refresh)"
			},
			{
				"command": "ungate.startTunnel",
				"title": "Start Tunnel",
				"category": "Ungate"
			},
			{
				"command": "ungate.restartTunnel",
				"title": "Restart Tunnel",
				"category": "Ungate"
			},
			{
				"command": "ungate.stopTunnel",
				"title": "Stop Tunnel Only",
				"category": "Ungate"
			},
			{
				"command": "ungate.restartServices",
				"title": "Restart Shared API",
				"category": "Ungate"
			},
			{
				"command": "ungate.stopServices",
				"title": "Stop Shared API and Tunnel",
				"category": "Ungate"
			}
		],
		"menus": {
			"editor/title": [
				{
					"command": "ungate.openCursorModels",
					"when": "activeWebviewPanelId == ungate",
					"group": "navigation@1"
				},
				{
					"command": "ungate.reloadWindow",
					"when": "activeWebviewPanelId == ungate",
					"group": "navigation@2"
				},
				{
					"command": "ungate.restartServices",
					"when": "activeWebviewPanelId == ungate",
					"group": "ungate@1"
				},
				{
					"command": "ungate.stopServices",
					"when": "activeWebviewPanelId == ungate",
					"group": "ungate@2"
				}
			]
		}
	},
	"scripts": {
		"build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"test": "vitest run"
	},
	"dependencies": {
		"@ungate/shared": "workspace:*",
		"cloudflared": "~0.7.1",
		"tar": "~6.2.1",
		"zod": "~4.3.6"
	},
	"devDependencies": {
		"@types/node": "~22.15.35",
		"@types/vscode": "~1.96.0",
		"@ungate/dev-kit": "workspace:*",
		"@vscode/vsce": "~3.2.0",
		"ovsx": "~0.10.11",
		"tsup": "~8.5.1",
		"typescript": "~5.7.0",
		"vitest": "~4.0.18"
	},
	"packageManager": "pnpm@10.24.0"
}
