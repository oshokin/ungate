{
	"extends": "@ungate/dev-kit/tsconfig-base",
	"compilerOptions": {
		"paths": {
			"$shared/*": ["./src/shared/*"],
			"$components/*": ["./src/components/*"],
			"$features/*": ["./src/features/*"],
			"$layouts/*": ["./src/layouts/*"],
			"$src/*": ["./src/*"]
		},
		"types": ["node", "vite/client"],
		"verbatimModuleSyntax": true,
		"noEmit": true
	},
	"include": ["src", "tests", "vite.config.ts", "vitest.config.ts", "svelte.config.js", "eslint.config.mjs"],
	"exclude": ["node_modules", "dist"]
}
