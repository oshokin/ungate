{
	"name": "@ungate/api",
	"type": "module",
	"scripts": {
		"start": "DB_PATH=$HOME/.ungate/data-dev.db PORT=4783 node -r source-map-support/register dist/main.js",
		"build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths",
		"build:watch": "pnpm run clean && tsc-watch -p tsconfig.build.json --onCompilationComplete \"pnpm run build:postbuild\"",
		"build:postbuild": "tsc-alias -p tsconfig.build.json --resolve-full-paths",
		"build:bundle": "tsup",
		"clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
		"lint": "eslint src/",
		"lint:fix": "eslint src/ --fix",
		"test": "vitest run --config tests/unit/vitest.config.ts && vitest run --config tests/integration/vitest.config.ts",
		"test:unit": "vitest run --config tests/unit/vitest.config.ts",
		"test:integration": "vitest run --config tests/integration/vitest.config.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate"
	},
	"dependencies": {
		"@fastify/cors": "~11.3.1",
		"@ungate/shared": "workspace:*",
		"better-sqlite3": "13.0.3",
		"date-fns": "~4.4.0",
		"drizzle-orm": "~0.45.4",
		"fastify": "~5.12.7",
		"lodash-es": "~4.18.1",
		"source-map-support": "~0.5.21",
		"tslib": "~2.8.1",
		"zod": "~4.6.7"
	},
	"devDependencies": {
		"@types/better-sqlite3": "~9.6.0",
		"@types/lodash-es": "~4.17.12",
		"@types/node": "~24.19.2",
		"@ungate/dev-kit": "workspace:*",
		"@vitest/coverage-v8": "~5.0.5",
		"drizzle-kit": "~0.31.11",
		"esbuild": "~0.28.2",
		"tsc-alias": "~1.9.9",
		"tsc-watch": "~7.2.1",
		"tsup": "~9.0.0",
		"typescript": "~6.0.3",
		"vite": "~8.3.5",
		"vitest": "~5.0.5"
	}
}
